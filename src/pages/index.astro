---
import "../styles/global.css";
import JeopardyGame from "../components/JeopardyGame";
import { quizPack } from "../content/pack";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta
      name="description"
      content={quizPack.subtitle ?? `Kuis bergaya Jeopardy: ${quizPack.title}.`}
    />
    <meta name="color-scheme" content="light" />
    <title>{quizPack.title}</title>
  </head>
  <body>
    <JeopardyGame client:load />
  </body>
</html>
